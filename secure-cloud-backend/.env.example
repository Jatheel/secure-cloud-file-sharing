# MongoDB connection string (MongoDB Atlas or local, e.g. mongodb://127.0.0.1:27017/securecloud)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/securecloud

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Backend port
PORT=5001

# Where the frontend runs (used in share links)
FRONTEND_URL=http://localhost:5173

# Optional: separate secret for encrypting files (falls back to JWT_SECRET).
# Do NOT change this after uploading files, or old files can't be decrypted.
# FILE_ENCRYPTION_SECRET=

# Optional: Ethereal test email account (https://ethereal.email) for share notifications
# ETHEREAL_USER=
# ETHEREAL_PASS=
